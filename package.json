	"description": "O.O.M. W.G.",
	"license": "F2DLPRL",
	"author": "O.O.M. W.G.",
	"type": "module",
	"scripts": {
		"astro": "astro",
		"build": "astro check && astro build && pagefind --site dist",
		"dev": "astro dev",
		"lint": "prettier --write .",
		"new-developer": "node scripts/new-developer.js",
		"new-post": "node scripts/new-post.js",
		"new-project": "node scripts/new-project.js",
		"prepare": "pnpm exec simple-git-hooks",
		"preview": "astro preview"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged",
		"commit-msg": "pnpm exec commitlint --edit $1"
	},
	"lint-staged": {
		"*.{js,mjs,jsx,ts,mts,tsx,astro,vue,md,mkd,mdx,css,scss,html,htm,yml,yaml,json,jsonc}": "prettier --write"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.6",
		"@astrojs/markdown-remark": "^6.3.10",
		"@astrojs/react": "^4.4.2",
		"@astrojs/rss": "^4.0.14",
		"@astrojs/sitemap": "^3.6.0",
		"@astrojs/tailwind": "^6.0.2",
		"@radix-ui/react-dialog": "^1.1.15",
		"@shikijs/rehype": "^3.19.0",
		"@swup/astro": "^1.7.0",
		"@types/chroma-js": "^3.1.2",
		"@types/lodash-es": "^4.17.12",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"astro": "^5.16.5",
		"astro-mermaid": "^1.2.0",
		"chroma-js": "^3.2.0",
		"clsx": "^2.1.1",
		"framer-motion": "^12.23.26",
		"hastscript": "^9.0.1",
		"jotai": "^2.16.0",
		"katex": "^0.16.27",
		"lodash-es": "^4.17.21",
		"mdast-util-to-string": "^4.0.0",
		"pagefind": "^1.4.0",
		"qrcode.react": "^4.2.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-toastify": "^11.0.5",
		"reading-time": "^1.5.0",
		"rehype-katex": "^7.0.1",
		"remark-directive": "^4.0.0",
		"remark-math": "^6.0.0",
		"tailwindcss": "^3.4.19",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@inquirer/prompts": "^5.5.0",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"autoprefixer": "^10.4.22",
		"lint-staged": "^15.5.2",
		"mermaid": "^11.12.2",
		"micromark-util-symbol": "^2.0.1",
		"postcss": "^8.5.6",
		"postcss-html": "^1.8.0",
		"prettier": "^3.7.4",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-lint-md": "^1.0.1",
		"simple-git-hooks": "^2.13.1",
		"stylelint": "^16.26.1",
		"stylelint-config-standard-scss": "^16.0.0",
		"stylelint-config-standard-vue": "^1.0.0",
