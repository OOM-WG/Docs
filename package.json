{
	"name": "oom-websites",
	"private": true,
	"license": "File-to-Downloader",
	"author": "OOM WG",
	"workspaces": [
		"apps/*",
		"blog",
		"docs",
		"nav"
	],
	"type": "module",
	"scripts": {
		"docs:dev": "bun run --cwd docs dev",
		"blog:dev": "bun run --cwd blog dev",
		"blog:build": "bun run --cwd blog build",
		"blog:preview": "bun run --cwd blog preview",
		"ssu:dev": "bun run --cwd apps/ssu dev",
		"ssu:build": "bun run --cwd apps/ssu build",
		"ssu:start": "bun run --cwd apps/ssu start",
		"nav:dev": "bun run --cwd nav dev",
		"nav:build": "bun run --cwd nav build",
		"nav:preview": "bun run --cwd nav preview",
		"check": "vp check",
		"lint": "vp lint && stylelint '**/src/**/*.{css,astro}'",
		"format": "prettier --write '**/*{mdx,js,jsx,ts,tsx,astro}' && vp fmt"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"postcss-html": "^1.8.1",
		"prettier": "^3.9.5",
		"prettier-plugin-astro": "^0.14.1",
		"stylelint": "^17.14.0",
		"stylelint-config-astro": "^2.0.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-config-tailwindcss": "^1.0.1",
		"stylelint-plugin-defensive-css": "^2.9.4",
		"stylelint-plugin-logical-css": "^2.1.0",
		"vite-plus": "^0.2.4"
	}
}