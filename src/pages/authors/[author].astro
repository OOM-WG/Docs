---
import type {GetStaticPaths} from 'astro'
import PageLayout from '@/layouts/PageLayout.astro'
import {getAllAuthors, getOldestPosts, slugify} from '@/utils/content'
import Highlight from '@/components/Highlight.astro'
import Timeline from '@/components/Timeline.astro'

export const getStaticPaths = (async () => {
	return (await getAllAuthors()).map(author => {
		return {
			params: {
				author: author.slug
			},
			props: {author}
		}
	})
}) satisfies GetStaticPaths

interface Props {
	author: {
		name: string
		slug: string
		count: number
	}
}

const {author} = Astro.props

const oldestPosts = await getOldestPosts().then(posts => {
	return posts.filter(post => post.data.author && slugify(post.data.author) === author.slug)
})
---

<PageLayout title={`作者 · ${author.name}`}>
	<div class='max-w-[800px] mx-auto px-4 py-16'>
		<header class='space-y-4 mb-8'>
			<h1 class='text-4xl font-bold'>
				作者: <Highlight>{author.name}</Highlight>
			</h1>
			<p>共有 {author.count} 篇文章</p>
		</header>
		<Timeline posts={oldestPosts} />
	</div>
</PageLayout>
