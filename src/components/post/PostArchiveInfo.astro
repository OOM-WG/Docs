---
import {slugify} from '@/utils/content'

interface Props {
	tags: string[]
	author?: string
	class?: string
}

const {tags, author, class: className} = Astro.props
---

<div class='flex flex-wrap gap-2 text-sm text-secondary' class:list={[className]}>
	{
		author && (
			<div>
				<i class='iconfont icon-rocket' />
				<a
					class='hover:text-accent hover:underline underline-offset-2 decoration-dashed'
					href={`/authors/${slugify(author)}`}>
					{author}
				</a>
			</div>
		)
	}
	{
		tags.length > 0 && (
			<div>
				<i class='iconfont icon-hashtag' />
				{tags.map((tag, index) => (
					<>
						{index > 0 && <span>, </span>}
						<a
							class='hover:text-accent hover:underline underline-offset-2 decoration-dashed'
							href={`/tags/${slugify(tag)}`}>
							{tag}
						</a>
					</>
				))}
			</div>
		)
	}
</div>
