        "global": {
          "anchors": [
            {
              "anchor": "Github",
              "icon": "github",
              "href": "https://github.com/oom-wg"
            },
            {
              "anchor": "加入群组",
              "icon": "users",
              "href": "https://oom-wg.dev/we/join"
            }
          ]
        }
      }
