                "icon": "book-open",
                "pages": ["index", "we/member", "we/join"]
              },
              {
                "group": "最新发布",
                "icon": "calendar",
                "pages": [
                  "blog/oow-timeline",
                  "blog/shell-obf-enc",
                  "blog/go4-sukisu-ultra-2",
                  "blog/oow-dev-ref",
                  "blog/ai-for-root",
                  "blog/go4-mi-oplusrm-sukisu",
                  "blog/ssu-ko-fund",
                  "blog/go4-sukisu-ultra",
                  "blog/suu-for-data-opt"
                ]
              }
            ]
          },
          {
            "dropdown": "ShiroSU",
            "icon": "drafting-compass",
            "pages": [
              {
                "group": "快速开始",
                "pages": [
                  "ssu/base/overview",
                  "ssu/base/install",
                  "ssu/base/feats",
                  "ssu/base/faq"
                ]
              },
              {
                "group": "开发者文档",
                "pages": [
                  "ssu/dev/module/manager",
                  "ssu/dev/module/cfgui",
                  "ssu/dev/module/webui",
                  "ssu/dev/module/root",
                  "ssu/dev/module/kernel",
                  "ssu/dev/module/builder",
                  "ssu/dev/scheme"
                ]
              },
              {
                "group": "SSU 详细文档",
                "pages": [
                  "ssu/ssu/origin",
                  "ssu/ssu/principle",
                  "ssu/ssu/defense",
                  "ssu/ssu/compat"
                ]
              },
              {
                "group": "更新日志",
                "pages": ["ssu/update/history"]
              }
            ]
          },
          {
            "dropdown": "苏柚",
            "icon": "pencil-ruler",
            "pages": [
              {
                "group": "快速开始",
                "pages": [
                  "suu/Guide",
                  "suu/Features",
                  "suu/Changelog"
                ]
              },
              {
                "group": "更多信息",
                "pages": [
                  "suu/More/Agreement",
                  "suu/More/License",
                  "suu/More/Privacy"
                ]
              }
            ]
          }
