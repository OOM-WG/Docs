    "body": {
      "family": "JetBrains Mono",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "favicon.ico",
  "navigation": {
    "languages": [
      {
        "language": "zh",
        "dropdowns": [
          {
            "dropdown": "博客",
