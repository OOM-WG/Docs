{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "maple",
	"name": "回忆溢出工作组",
	"description": "致力于用编程创造美好回忆的组织",
	"footer": {
		"socials": {
			"telegram": "https://t.me/OOM_WG",
			"github": "https://github.com/OOM-WG",
			"discord": "https://discord.gg/4HQ2DaqKX"
		}
	},
	"favicon": "/images/logo/oow.ico",
	"logo": {
		"light": "/images/logo/oow.webp",
		"dark": "/images/logo/oow.webp"
	},
	"colors": {
		"primary": "#4a5bab",
		"light": "#b4cce9",
		"dark": "#4a5bab"
	},
	"fonts": {
		"heading": {"family": "Ubuntu Mono"},
		"body": {"family": "JetBrains Mono"}
	},
	"icons": {
		"library": "lucide"
	},
	"redirects": [
		{
			"source": "/posts/:path*",
			"destination": "/blog/:path*"
		}
	],
	"errors": {
		"404": {
			"redirect": false,
			"title": "您走丢了吗？",
			"description": "请确保链接**没有缺失**或**没有多余的*申请恢复访问***，若仍不可用请**联系开发者**"
		}
	},
	"metadata": {
		"timestamp": true
	},
	"contextual": {
		"options": ["copy", "view", "chatgpt", "claude", "perplexity"]
	},
	"seo": {
		"indexing": "all",
		"metatags": {
			"canonical": "https://oom-wg.dev",
			"baidu-site-verification": "codeva-Y9T3t5qRxy"
		}
	},
	"navigation": {
		"languages": [
			{
				"language": "zh",
				"dropdowns": [
					{
						"dropdown": "博客",
						"icon": "rss",
						"groups": [
							{
								"group": "简介",
								"icon": "book-open",
								"pages": ["index", "developers", "projects", "projects-ext"]
							},
							{
								"group": "回忆篇章",
								"icon": "calendar",
								"pages": [
									"blog/go4-sukisu-ultra-3",
									"blog/oow-timeline",
									"blog/shell-obf-enc",
									"blog/go4-sukisu-ultra-2",
									"blog/oow-dev-ref",
									"blog/ai-for-root",
									"blog/go4-mi-oplusrm-sukisu",
									"blog/ssu-ko-fund",
									"blog/go4-sukisu-ultra",
									"blog/suu-for-data-opt"
								]
							}
						]
					},
					{
						"dropdown": "ShiroSU",
						"icon": "drafting-compass",
						"pages": [
							{
								"group": "快速开始",
								"pages": [
									"ssu/base/overview",
									"ssu/base/install",
									"ssu/base/feats",
									"ssu/base/faq"
								]
							},
							{
								"group": "开发者文档",
								"pages": [
									"ssu/dev/module/index",
									"ssu/dev/module/manager",
									"ssu/dev/module/cfgui",
									"ssu/dev/module/webui",
									"ssu/dev/module/root",
									"ssu/dev/module/kernel",
									"ssu/dev/module/builder",
									"ssu/dev/scheme"
								]
							},
							{
								"group": "SSU 详细文档",
								"pages": [
									"ssu/ssu/origin",
									"ssu/ssu/principle",
									"ssu/ssu/defense",
									"ssu/ssu/compat"
								]
							},
							{
								"group": "更新日志",
								"pages": ["ssu/update/history"]
							}
						]
					},
					{
						"dropdown": "苏柚",
						"icon": "pencil-ruler",
						"pages": [
							{
								"group": "快速开始",
								"pages": ["suu/Guide", "suu/Features", "suu/Changelog"]
							},
							{
								"group": "更多信息",
								"pages": ["suu/More/Agreement", "suu/More/License", "suu/More/Privacy"]
							}
						]
					},
					{
						"dropdown": "MikotoMem",
						"icon": "gauge",
						"pages": ["mmem"]
					},
					{
						"dropdown": "YumeMem",
						"icon": "monitor-smartphone",
						"pages": ["only-gui-can-do"]
					}
				],
				"global": {
					"anchors": [
						{
							"anchor": "Github",
							"icon": "github",
							"href": "https://github.com/OOM-WG"
						},
						{
							"anchor": "加入群组",
							"icon": "users",
							"href": "https://oom-wg.dev/join"
						}
					]
				}
			}
		]
	}
}
