  "logo": {
    "light": "/logo/img.png",
    "dark": "/logo/img.png"
  },
  "seo": {
    "metatags": {
      "robots": "index, follow",
      "charset": "UTF-8",
      "viewport": "width=device-width, initial-scale=1.0",
      "googlebot": "index, follow",
      "generator": "Mintlify",
      "theme-color": "#f56c6c",
      "format-detection": "telephone=no",
      "referrer": "origin",
      "rating": "general",
      "revisit-after": "7 days",
      "language": "zh-CN",
      "copyright": "回忆溢出工作组 OOM. WG.",
      "distribution": "global",
      "HandheldFriendly": "True",
      "MobileOptimized": "320",
      "apple-mobile-web-app-capable": "yes",
      "apple-mobile-web-app-status-bar-style": "black",
      "apple-mobile-web-app-title": "OOM.WG.",
      "application-name": "OOM.WG.",
      "msapplication-TileColor": "#f56c6c",
      "og:type": "website",
      "og:image": "https://oom-wg.dev/logo/img.png",
      "og:site_name": "OOM.WG.",
      "og:locale": "zh_CN",
      "canonical": "https://oom-wg.dev"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
